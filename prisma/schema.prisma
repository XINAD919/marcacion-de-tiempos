generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model User {
  id              String          @id @default(uuid())
  cedula          String          @unique
  nombre          String
  email           String?
  // universidad | colegio | natural (src/lib/usuarios/tipoUsuario.ts).
  tipo            String          @default("universidad") @db.VarChar(20)
  // Vacías para los voluntarios naturales; obligatorias para los demás
  // (lo exige validateUsuarioInput, no la base).
  universidad     String?
  entidad         String?
  // Las define el convenio con la institución (maqueta 4c). 0 en naturales.
  horasRequeridas Int             @default(0)
  fechaInicio     DateTime?       @db.Date
  // Horario asignado "HH:mm"; sirve para marcar llegadas tarde.
  horaInicio      String?         @db.VarChar(5)
  horaFin         String?         @db.VarChar(5)
  activo          Boolean         @default(true)
  fechaRegistro   DateTime        @default(now())
  embeddings      FaceEmbedding[]
  attendance      AttendanceLog[]
  carnet          CarnetVirtual?

  @@index([nombre])
  @@index([tipo])
}

model Admin {
  id           String   @id @default(uuid())
  email        String   @unique
  nombre       String
  passwordHash String
  activo       Boolean  @default(true)
  creadoEn     DateTime @default(now())
}

model FaceEmbedding {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  embedding    Bytes
  modelo       String
  fechaCaptura DateTime @default(now())

  @@index([userId])
}

// Carnet virtual: respaldo cuando el rostro no se reconoce. El QR codifica
// `token`, no la cédula, para que no se pueda fabricar uno a partir de datos
// públicos. Tabla aparte porque en SQL Server un UNIQUE sobre una columna
// opcional de User solo admitiría un NULL.
model CarnetVirtual {
  userId    String    @id
  user      User      @relation(fields: [userId], references: [id])
  token     String    @unique @db.VarChar(64)
  creadoEn  DateTime  @default(now())
  enviadoEn DateTime?
  enviadoA  String?
}

model AttendanceLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  tipo      String
  metodo    String
  confianza Float?
  deviceId  String
  marcadoEn DateTime @default(now())

  @@index([userId, marcadoEn])
}

// Reglas globales de la maqueta 4g. Una sola fila (id = 1); si no existe se
// usan los valores por defecto de src/lib/server/config.ts.
model Configuracion {
  id                      Int      @id @default(1)
  // Minutos después de la hora de inicio antes de contar como llegada tarde.
  toleranciaLlegadaMin    Int      @default(10)
  // Tiempo mínimo entre la entrada y la salida del mismo día; antes de eso el
  // kiosko no registra la salida y remite a coordinación.
  minMinutosAntesSalida   Int      @default(60)
  // Las mismas dos reglas, pero para los voluntarios naturales.
  toleranciaLlegadaNaturalMin  Int @default(10)
  minMinutosAntesSalidaNatural Int @default(60)
  // flexible | equilibrado | estricto → umbral de distancia facial.
  exigenciaReconocimiento String   @default("equilibrado") @db.VarChar(20)
  intentosAntesQr         Int      @default(3)
  jornadaMaximaHoras      Int      @default(9)
  actualizadoEn           DateTime @updatedAt
  actualizadoPor          String?
}

// Correo de salida (SMTP) para enviar carnets virtuales. Una sola fila (id = 1).
// La contraseña se guarda cifrada con una clave derivada de AUTH_SECRET.
model ConfiguracionSmtp {
  id              Int      @id @default(1)
  host            String
  puerto          Int
  // tls (puerto 465) | starttls (587) | ninguna (relay interno, puerto 25)
  seguridad       String   @default("starttls") @db.VarChar(10)
  usuario         String?
  passwordCifrada String?  @db.VarChar(max)
  remitenteNombre String
  remitenteEmail  String
  actualizadoEn   DateTime @updatedAt
  actualizadoPor  String?
}
